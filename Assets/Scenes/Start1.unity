  m_Script: {fileID: 11500000, guid: 17de6071d82bbe842b5fc917161e208d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - subtitleText: "\u6211\u521A\u624D\u7528\u591C\u89C6\u4EEA\u770B\u4E86\uFF0C\u90A3\u4E9B\u91CE\u517D\u90FD\u5DF2\u7ECF\u79BB\u5F00\u4E86\u3002"
    audioClip: {fileID: 8300000, guid: cf9a3413265f3db4d9e8a1e2ac492eaa, type: 3}
    volume: 1
    fadeIn: 0
    fadeOut: 0
    displayDuration: 0
    loopTalkAnim: 0
    triggerTalkAnimation: 0
  - subtitleText: "\u4F60\u624B\u4E0A\u8FD9\u53F0\u6587\u5316\u5171\u9E23\u4EEA\uFF0C\u672C\u8BE5\u7528\u4E8E\u626B\u63CF\u6587\u660E\u9057\u8FF9\uFF0C\u4F46\u73B0\u5728\u4E5F\u65E0\u6CD5\u4F7F\u7528\u3002"
    audioClip: {fileID: 8300000, guid: 0e13ad9868b5e9a4e9dc191ee4834327, type: 3}
    volume: 1
    fadeIn: 0
    fadeOut: 0
    displayDuration: 0
    loopTalkAnim: 0
    triggerTalkAnimation: 1
  - subtitleText: "\u6211\u6628\u665A\u5DE1\u89C6\u7684\u65F6\u5019\uFF0C\u627E\u5230\u4E86\u4E00\u4E9B\u53E4\u8001\u9057\u8FF9\u7684\u788E\u7247\uFF0C\u4E0D\u8FC7\u6628\u665A\u592A\u9ED1\u4E86\uFF0C\u80FD\u89C1\u5EA6\u592A\u4F4E\uFF0C\u5468\u56F4\u5371\u673A\u56DB\u4F0F\uFF0C\u6CA1\u6709\u529E\u6CD5\u7EE7\u7EED\u5BFB\u627E\u3002\u8D81\u73B0\u5728\u5929\u521A\u4EAE\uFF0C\u91CE\u517D\u8FD8\u5728\u4F11\u606F\uFF0C\u6211\u4EEC\u6293\u7D27\u5BFB\u627E\u7EBF\u7D22\uFF0C\u6211\u6709\u9884\u611F\uFF0C\u9057\u8FF9\u5C31\u5728\u79BB\u8FD9\u91CC\u4E0D\u8FDC\u7684\u5730\u65B9\uFF01\u5927\u5BB6\u52A0\u6CB9"
    audioClip: {fileID: 8300000, guid: ca7b815539b77d04e8b23ca8b66334ea, type: 3}
    volume: 1
    fadeIn: 0
    fadeOut: 0
    displayDuration: 0
    loopTalkAnim: 0
    triggerTalkAnimation: 1
  - subtitleText: "\u4F7F\u7528\u535A\u58EB\u7ED9\u6211\u4EEC\u7684\u55B7\u6C14\u80CC\u5305\uFF0C\u6211\u4EEC\u98DE\u8FC7\u53BB\uFF0C\u8FD9\u6837\u65F6\u95F4\u4F1A\u5FEB\u4E00\u70B9\u4E5F\u4F1A\u907F\u514D\u5730\u9762\u4E0A\u7684\u5371\u9669"
    audioClip: {fileID: 8300000, guid: 6e90da8fcd1b42942bb1ce8915c36d9f, type: 3}
    volume: 1
    fadeIn: 0
    fadeOut: 0
    displayDuration: 0
    loopTalkAnim: 0
