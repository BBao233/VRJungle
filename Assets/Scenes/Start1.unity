--- !u!114 &1839547759
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1839547748}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17de6071d82bbe842b5fc917161e208d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueLines:
  - subtitleText: "\u4E0D\u8FC7\u4E0D\u7528\u62C5\u5FC3\uFF0C\u6211\u4EEC\u57FA\u672C\u4EFB\u52A1\u5DF2\u7ECF\u5B8C\u6210\u3002\u4F60\u4EEC\u542C\u8FD9\u5C31\u662F\u96E8\u6797\u7684\u5FC3\u8DF3\uFF0C\u4ECA\u665A\u6211\u4EEC\u5C31\u5728\u8FD9\u91CC\u4FEE\u6574\uFF0C\u660E\u65E9\u518D\u51FA\u53D1\u3002"
    audioClip: {fileID: 8300000, guid: e68a3add4897db24ba16de45b91a43e3, type: 3}
    volume: 0.97
    fadeIn: 0
    fadeOut: 0
    displayDuration: 0
    loopTalkAnim: 0
    triggerTalkAnimation: 1
  - subtitleText: "\u4F60\u9192\u4E86\uFF0C\u90A3\u6211\u4EEC\u6536\u62FE\u4E00\u4E0B\uFF0C\u5F00\u59CB\u5BFB\u627E\u9057\u8FF9\u7684\u7EBF\u7D22\u5427"
    audioClip: {fileID: 8300000, guid: 790a09b1fdd019a41b37d9ab5c63cec5, type: 3}
    volume: 0.97
    fadeIn: 0
    fadeOut: 0
    displayDuration: 0
    loopTalkAnim: 0
    triggerTalkAnimation: 1
  - subtitleText: "\u4F60\u4EEC\u5FEB\u770B\uFF0C\u6811\u4E1B\u540E\u597D\u50CF\u6709\u4EC0\u4E48\uFF1F\u6211\u4EEC\u8FC7\u53BB\u770B\u770B\uFF01"
    audioClip: {fileID: 8300000, guid: da59446126eb42542b0041bae788924a, type: 3}
    volume: 0.97
    fadeIn: 0
    fadeOut: 0
    displayDuration: 0
    loopTalkAnim: 0
    triggerTalkAnimation: 1
  - subtitleText: "\u5FEB\u770B\uFF0C\u90A3\u662F\u91D1\u5B57\u5854\u5417\uFF0C\u6211\u60F3\u8FD9\u5E94\u8BE5\u4E0D\u662F\u5E7B\u89C9\uFF0C\u5FEB\uFF01\u6211\u4EEC\u5F97\u5F80\u90A3\u91CC\u53BB\u4E00\u63A2\u7A76\u7ADF"
    audioClip: {fileID: 8300000, guid: 2ce7da239a83aa3448f3e9389ecadf8f, type: 3}
    volume: 0.97
    fadeIn: 0
    fadeOut: 0
    displayDuration: 0
    loopTalkAnim: 0
    triggerTalkAnimation: 1
  - subtitleText: "\u7CDF\u4E86\uFF0C\u6211\u4EEC\u7684\u8BBE\u5907\u597D\u50CF\u5728\u9003\u8DD1\u9014\u4E2D\u6536\u5230\u4E86\u635F\u574F\uFF0C\u5927\u5BB6\u4F7F\u7528\u7684\u65F6\u5019\u8981\u5C0F\u5FC3\u54E6\uFF0C\u4E0D\u8FC7\uFF0C\u627E\u5230\u4F7F\u7528\u7684\u89C4\u5F8B\uFF0C\u6211\u4EEC\u5C31\u80FD\u987A\u5229\u5230\u8FBE\u739B\u96C5\u6587\u660E\uFF01"
    audioClip: {fileID: 8300000, guid: 39b9777404814a6458f0040807642b9c, type: 3}
    volume: 0.97
    fadeIn: 0
    fadeOut: 0
    displayDuration: 0
    loopTalkAnim: 0
    triggerTalkAnimation: 1
